# Copy this file to .env and fill in ONE provider below. Never commit .env.
#
# This project runs on any OpenAI-compatible endpoint, so switching providers
# is a .env edit - no code changes. Pick one, uncomment it, paste your key.

# ---------------------------------------------------------------------------
# OPTION 1 (recommended) - Google Gemini free tier
# Get a key at https://aistudio.google.com  (no credit card)
# ---------------------------------------------------------------------------
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# OPTION 2 - Groq free tier (much faster, open-weights models, tighter RPM)
# Get a key at https://console.groq.com  (no credit card)
# ---------------------------------------------------------------------------
# LLM_API_KEY=your-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# OPTION 3 - Anthropic (paid; new accounts get a small starter credit)
# ---------------------------------------------------------------------------
# LLM_API_KEY=your-key-here
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-4-5-20251001

# Embedding model - runs locally via sentence-transformers, never hits an API
EMBEDDING_MODEL=all-MiniLM-L6-v2
